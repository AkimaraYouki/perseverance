<?xml version="1.0" encoding="UTF-8"?>
<!-- Robot-local DDS: loopback always works (on-robot nodes keep talking if Wi-Fi drops);
     Wi-Fi is used when present for remote tools. l4tbr0 (192.168.55.x USB device mode) is
     deliberately excluded because it overlaps other networks. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" priority="default" multicast="false"/>
        <NetworkInterface name="wlP1p1s0" presence_required="false"/>
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="localhost"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
