<?xml version="1.0" encoding="UTF-8"?>
<!-- gen2 DDS, Wi-Fi mode (generated by gen2_dds.sh when @IFACE@ has an IPv4 address).
     Wi-Fi is the only interface: a loopback interface in the list becomes the primary one on
     Cyclone 0.10 and breaks Wi-Fi (desktop report 2026-09-25_2330). Multicast only for SPDP
     discovery; data is unicast (multicast data on Wi-Fi is slow and lossy). Peers come from
     dds_peers.txt so discovery also works on networks that block multicast. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="@IFACE@"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
@PEERS@
    </Discovery>
  </Domain>
</CycloneDDS>
