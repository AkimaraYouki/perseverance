<?xml version="1.0" encoding="UTF-8"?>
<!-- gen2 DDS, network mode (generated by gen2_dds.sh from the interfaces that have IPv4).
     No loopback entry: it became Cyclone 0.10's primary interface and broke off-board traffic
     (desktop report 2026-09-25_2330). Wired campus LAN: multicast off (peers only). Wi-Fi:
     multicast only for SPDP discovery, data unicast. Peers come from dds_peers.txt. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
@INTERFACES@      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
@PEERS@
    </Discovery>
  </Domain>
</CycloneDDS>
