#!/bin/sh
# NetworkManager dispatcher: when the wired port comes up, pin the desk-debug peers from
# /etc/gen2/wired_peers.conf (on-link /32 route + permanent ARP) — protects against the ARP
# spoofer on the campus LAN. Removes them again when the port goes down.
IFACE="$1"; ACTION="$2"; CONF=/etc/gen2/wired_peers.conf
[ "$IFACE" = "enP8p1s0" ] || exit 0
[ -f "$CONF" ] || exit 0
grep -vE '^\s*(#|$)' "$CONF" | while read -r ip mac _; do
  case "$ACTION" in
    up|dhcp4-change)
      ip route replace "$ip/32" dev "$IFACE"
      ip neigh replace "$ip" lladdr "$mac" dev "$IFACE" nud permanent
      logger -t gen2-wired "pinned $ip ($mac) on $IFACE" ;;
    down)
      ip route del "$ip/32" dev "$IFACE" 2>/dev/null
      ip neigh del "$ip" dev "$IFACE" 2>/dev/null ;;
  esac
done
exit 0
