  for a in "$@"; do [ "$a" = "--record" ] && rec=1 || args+=("$a"); done
  if [[ " ${args[*]} " == *" --joystick "* ]] && [[ " ${args[*]} " != *" --obstacle "* ]]; then
    args+=(--obstacle stairs2)                                   # 패드 모드 기본 = 2 단 턱
  fi
