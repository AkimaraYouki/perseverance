robust)
  # pv robust [N] [--only flat_stop,ridges,...] [TUNE 덮어쓰기 --키 값 ...]
  #   강인성 시험 세트: 시나리오마다 로봇 N 대 (대마다 다른 모델 오차·잡음·지연) -> 통과율 표. 게인은 climb_test.py TUNE
  n=8; if [[ "${1:-}" =~ ^[0-9]+$ ]]; then n="$1"; shift; fi
  only="flat_stop,turn,ridges,ramp,jump,hand10,hand20,stones8,oneside8,stones_turn,fast_turn"; args=()
  while [ $# -gt 0 ]; do if [ "$1" = "--only" ]; then only="$2"; shift 2; else args+=("$1"); shift; fi; done
  require_free_gpu
  cd "$PROJ"; mkdir -p "$OUT/robust"; stamp=$(date +%H%M%S)
  for sc in ${only//,/ }; do
    "$IL" -p scripts/_isaaclab_launch.py scripts/robust_suite.py --scenario "$sc" --n "$n" "${args[@]}" \
      --out "$OUT/robust/${stamp}_$sc.json" > "$RUNLOG/robust_$sc.log" 2>&1
    grep -E "^SUITE" "$RUNLOG/robust_$sc.log" || { echo "!! $sc 실패 — $RUNLOG/robust_$sc.log"; tail -5 "$RUNLOG/robust_$sc.log"; }
    ddc_clean 30        # 이 실행이 만든 Kit 지형 캐시 정리 (지형 메시 쿠킹이 실행마다 수백 MB ~ GB 쌓임)
  done
  python3 - "$OUT/robust" "$stamp" <<'PY'
import glob, json, os, statistics as st, sys
d, stamp = sys.argv[1], sys.argv[2]
rows = [json.load(open(f)) for f in sorted(glob.glob(os.path.join(d, f"{stamp}_*.json")))]
print("\n시나리오      통과     넘어짐   pitch95 중앙  roll95 중앙")
tot = [0, 0]
for r in rows:
    R_ = r["rows"]; fall = sum(x["fell_t"] is not None for x in R_)
    p = [x["pitch95"] for x in R_ if x["pitch95"] is not None]; q = [x["roll95"] for x in R_ if x["roll95"] is not None]
    hh = r.get("tune", {}); tag = r["scenario"]
    print(f"{tag:12s}  {r['npass']:2d}/{r['n']:<2d}    {fall:2d}       {st.median(p):5.1f}        {st.median(q):5.1f}")
    tot[0] += r["npass"]; tot[1] += r["n"]
if tot[1]:
    print(f"합계          {tot[0]}/{tot[1]} ({100*tot[0]/tot[1]:.0f} %)   결과: {d}/{stamp}_*.json")
PY
  ;;

