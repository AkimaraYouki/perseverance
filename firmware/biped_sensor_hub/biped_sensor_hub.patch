+// ---------------------------------------------------------------------------
+// u-blox M9 configuration interface: UBX-CFG-VALSET (0x06 0x8A), RAM layer only
+// (nothing is written to the module's flash/BBR). Key IDs from the u-blox M9 SPG
+// interface description:
+//   CFG-UART1-BAUDRATE            0x40520001 U4
+//   CFG-UART1INPROT-UBX           0x10730001 L
+//   CFG-UART1OUTPROT-UBX          0x10740001 L
+//   CFG-UART1OUTPROT-NMEA         0x10740002 L
+//   CFG-RATE-MEAS                 0x30210001 U2 (ms)
+//   CFG-RATE-NAV                  0x30210002 U2
+//   CFG-MSGOUT-UBX_NAV_PVT_UART1  0x20910007 U1
+// ---------------------------------------------------------------------------
+static uint8_t valset_buf[64];
+static uint16_t valset_len = 0;
+
+void valsetBegin() {
+  valset_buf[0] = 0x00;   // version
+  valset_buf[1] = 0x01;   // layers: RAM
+  valset_buf[2] = 0x00;
+  valset_buf[3] = 0x00;
+  valset_len = 4;
+}
+
+void valsetKey(uint32_t key, uint32_t value, uint8_t size) {
+  for (int i = 0; i < 4; ++i) valset_buf[valset_len++] = (uint8_t)(key >> (8 * i));
+  for (int i = 0; i < size; ++i) valset_buf[valset_len++] = (uint8_t)(value >> (8 * i));
+}
+
+void valsetSend() {
+  sendUbx(0x06, 0x8A, valset_buf, valset_len);
+}
+
+// Port settings only (sent at the probed baud; takes effect after the ACK).
+void setGpsPortM9() {
+  valsetBegin();
+  valsetKey(0x40520001UL, GPS_UART_BAUD, 4);   // CFG-UART1-BAUDRATE
+  valsetKey(0x10730001UL, 1, 1);               // CFG-UART1INPROT-UBX
+  valsetKey(0x10740001UL, 1, 1);               // CFG-UART1OUTPROT-UBX
+  valsetSend();
+}
+
+// Output configuration (sent at GPS_UART_BAUD).
+void configureGpsM9() {
+  valsetBegin();
+  valsetKey(0x30210001UL, GPS_MEAS_PERIOD_MS, 2);  // CFG-RATE-MEAS
+  valsetKey(0x30210002UL, 1, 2);                   // CFG-RATE-NAV
+  valsetKey(0x20910007UL, 1, 1);                   // CFG-MSGOUT-UBX_NAV_PVT_UART1
+  valsetKey(0x10740002UL, 0, 1);                   // CFG-UART1OUTPROT-NMEA off
+  valsetSend();
+}
+
+// Legacy UBX-CFG-PRT for UART1 (u-blox M8 and older): 8N1, GPS_UART_BAUD, UBX+NMEA.
+void setGpsPort() {
+  const uint32_t baud = GPS_UART_BAUD;
+  uint8_t p[20] = {
+    1, 0,             // portID = UART1, reserved
+    0, 0,             // txReady
+    0xD0, 0x08, 0, 0, // mode: 8 bits, no parity, 1 stop
+    (uint8_t)(baud), (uint8_t)(baud >> 8), (uint8_t)(baud >> 16), (uint8_t)(baud >> 24),
+    0x03, 0x00,       // inProtoMask  UBX | NMEA
+    0x03, 0x00,       // outProtoMask UBX | NMEA
+    0, 0, 0, 0        // flags, reserved
+  };
+  sendUbx(0x06, 0x00, p, sizeof(p));
+}
+
+// Called from loop() until NAV-PVT is seen: try the next baud, switch the module to
+// GPS_UART_BAUD, then send the normal configuration at GPS_UART_BAUD.
+void serviceGpsAutobaud(uint64_t nowUs) {
+  if (gps_pvt.seen || nowUs < next_gps_retry_us) {
+    return;
+  }
+  ++gps_retries;
+  next_gps_retry_us = nowUs + (gps_retries < GPS_FAST_RETRIES ? GPS_RETRY_MS : GPS_SLOW_RETRY_MS) * 1000ULL;
+  const uint32_t probe = GPS_BAUDS[gps_baud_idx];
+  gps_baud_idx = (gps_baud_idx + 1) % (sizeof(GPS_BAUDS) / sizeof(GPS_BAUDS[0]));
+  Serial1.updateBaudRate(probe);
+  setGpsPortM9();          // M9: VALSET
+  Serial1.flush();
+  delay(10);
+  setGpsPort();            // M8 and older: legacy CFG-PRT (M9 NAKs/ignores harmlessly)
+  Serial1.flush();
+  delay(20);
+  Serial1.updateBaudRate(GPS_UART_BAUD);
+  delay(20);
+  configureGpsM9();
+  delay(10);
+  configureGps();          // legacy CFG-RATE / CFG-MSG for M8
+}
